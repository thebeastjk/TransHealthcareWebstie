---
import { Font } from "astro:assets";
import Header from "../Components/Header.astro";
import Footer from "../Components/Footer.astro";
import SmoothScroll from "../Components/SmoothScroll.astro";
import { useTranslations } from "../i18n/utils";
import "../styles/global.css"
import Citation from "../Components/Citation.astro";
import { SEO } from "astro-seo";

const { title } = Astro.props
const t = useTranslations();
import type {Cite, Link} from "../types";

const links = [
    { title: 'Home', url: '/TransHealthcareWebstie/' },
    { title: 'About Us', url: '/TransHealthcareWebstie/About' },
    { title: 'Story', url: '/TransHealthcareWebstie/Story' },
    { title: 'Facts', url: '/TransHealthcareWebstie/Facts' },
];

import faviconSvgSrc from '../assets/tflag.svg'
import {getImage} from "astro/assets";

interface Props {
    Citations: Cite[],
}

const { Citations } = Astro.props;
const data = Astro.locals;

---


<html lang="en">
    <head>
        <SEO
            title="The Pain of Waiting"
            description="A website built for information about the struggles of trans healthcare in the U.S. south."
            extend={{
                // extending the default link tags
                link: [{ rel: "icon", href: "/TransHealthcareWebstie/favicon.ico" }],
                            // extending the default meta tags
            }}
        />
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <Font cssVariable="--font-roboto-slab" preload />
        <Font cssVariable="--font-inter" preload />
        <title>{title + " - The Pain of Waiting"}</title>
        <link href="../styles/output.css" rel="stylesheet">
        <link rel="icon" href="/TransHealthcareWebstie/favicon.ico" sizes="32x32"/>
        <link rel="manifest" href="/TransHealthcareWebstie/site.webmanifest" />


    </head>
    <body>
        <a href = "#main" class="skip-link">{t("accessibility.skip-to-content")}</a>
        <Header
            logoUrl="/TransHealthcareWebstie/"
            logoAlt=""
            links={links}
            link1={{title: "Interview", url:"/TransHealthcareWebstie/Interview"}}
            link2={{ title: "Disruptive action", url: "/TransHealthcareWebstie/Action" }}/>
        <main id="main">
            <div class="bg" />
            <slot/>
            <Citation Citations={Citations}/>
        </main>
        <Footer logoUrl="/" logoAlt="Huang & Knapp" links={links}/>
        <SmoothScroll />
    </body>
</html>

<style>
    .skip-link {
        background: var(--color-brand-1);
        left: 0;
        right: 0;
        margin: auto;
        width: min-content;
        white-space: nowrap;
        padding: 0.5rem;
        position: absolute;
        transform: translateY(-100%);
        transition: transform 0.3s ease;
        z-index: 100;
    }

    .skip-link:focus {
        transform: translateY(0%);
    }
</style>

<script>
    import "../utils/reveals";
</script>
