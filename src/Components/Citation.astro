---
import type { Cite } from "../types.ts"

interface Props {
    Citations: Cite[],
}

const { Citations } = Astro.props;
---

<div class="u-container py-3">
    <ul class="Container">
        {
            Citations.map((c) => (
                <li class="cite-list transition duration-1000 ease-in" id={c.Inline}>
                    <h4 >{"[" + c.Inline + "]"}</h4>
                    <p class="Citation">{c.mla}</p>
                </li>
            ))
        }
    </ul>
</div>

<style>
    .Citation {
        white-space: wrap;
        text-indent: 5rem hanging;
        color: black;

    }
    .Container {
        position: relative;
    }
    .cite-list {
        font-size: .8rem;
    }

</style>

