---
import Button from "./Button.astro";
import Logo from "../assets/tflag.svg";
import type { Link } from "../types";

interface Props {
    logoUrl: string;
    logoAlt: string;
    links: Link[];
    link1?:Link;
    link2?:Link;

}

const { logoUrl, logoAlt, link1, link2, links } = Astro.props;
---

<header>
    <sy-head>
        <div class="inner u-container">
            <div class="wrapper">
                <a class="logo" href={logoUrl}>
                    <Logo width="100" height="100"/>
                    <span class="u-src-only">{logoAlt}</span>
                    <span class="title">The Pain of Waiting</span>

                </a>

                <div class="border-spacing-0.5">
                    <ul class="flex flex-row  gap-4">
                        {
                            links.map((l) => (
                                <li class="">
                                    <p  class="text-lg group relative w-max">
                                       <a href={l.url}>{l.title}</a>
                                        <span class="absolute -bottom-1 left-0 w-0 transition-all h-0.5 bg-black group-hover:w-full"/>
                                    </p>

                                </li>
                            ))
                        }
                    </ul>
                </div>



                <div class="buttons">

                    <div class="dropdown dropdown-center outline-0">
                        <div tabindex="0" role="button" class="bg-transparent cursor-pointer">Mandates</div>
                        <ul tabindex="-1" class="dropdown-content outline-0 menu bg-linear-to-t from-blue-300/100 to-blue-300/0 rounded-box z-1 w-52 p-2 text-center">
                            <li><a href="/Ethical-Mandate">Ethical Mandate</a></li>
                            <li> <a href="/Theological-Mandate">Theological Mandate</a></li>
                        </ul>
                    </div>

                    {
                        link1 ? (
                            <a class="login" href={link1.url}>
                                {link1.title}
                            </a>
                        ) : null
                    }
                    {link2 ? <Button {...link2} revealable={false}/> : null}

                    <button type="button" class="toggle" aria-label="">
                        <span class="u-sr-only">Toggle Mobile Menu</span>
                        <span aria-hidden>
                            <span></span>
                            <span></span>
                            <span></span>
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </sy-head>
</header>

<style>
    .mandatestoggle {
        @extend %u-text;

        --fs: var(--font-size-sm);
        position: relative;
        transform: translateY(0);
        transition: 0.3s var(--ease-out-expo);
        transition-property: transform, color;
        cursor: pointer;



        &::after {
            content: "";
            position: absolute;
            height: 2px;
            background: currentcolor;
            top: 115%;
            width: 100%;
            left: 0;
            pointer-events: none;
            transform: scaleX(0);
            transition: transform 0.3s var(--ease-out-expo);
            transform-origin: right;
        }

        &:hover,
        &:focus {
            &::after {
                transform: scaleX(1);
                transform-origin: left;
            }
        }

        --breakpoint-phone:{
            display: none;
        };
    }
    .Descending {
        height: 0; /* 100% Full-height */
        width: 120%; /* 0 width - change this with JavaScript */
        position: relative; /* Stay in place */
        z-index: 1; /* Stay on top */
        top: 3rem; /* Stay at the top */
        left: 7rem;
        visibility: hidden;
        padding-bottom: .2rem;
        background: linear-gradient(0, rgba(91, 206, 250, 0.5), rgba(0, 0, 0, 0));
        border-radius: 0.5rem;
        overflow-x: hidden; /* Disable horizontal scroll */
         /* Place content 60px from the top */
        clip-path: rect(0px 250px 0px 0px round 20%);
        transition: clip-path 2s var(--ease-out-cubic);

        :global(body.Man-open) & {
            clip-path: rect(0px 250px 150px 0px round 20%);
            height: 25%;
            visibility: visible;
            transition: clip-path 1s var(--ease-out-cubic);

        }
    }
    .Descending a {
        padding: .2rem .2rem .2rem .2rem;
        text-decoration: none;
        display: block;
        transition: 0.3s;
    }
    .Descending a:hover {
        text-decoration: underline;
    }
    .title {
        text-align: left;
        padding: 0 .5rem ;


        --breakpoint-table:{
            visibility: hidden;
        };
        --breakpoint-phone:{
            visibility: hidden;
        };
    }
    sy-head {
        --br: 1.5rem;

        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 10;
        color: var(--color-text);
        margin: 0 auto;
        transition: transform 0.3s var(--ease-out-cubic);

        :global(body.is-nav-hidden) & {
            transform: translateY(-100%);
        }

        --breakpoint-phone:{
            --br: 1rem;
        };

        &::before,
        &::after {
            content: "";
            width: 100%;
            height: 100%;
            position: absolute;
            top: 0;
            left: 0;
            z-index: -1;
        }

        &::after {
            background: rgba(var(--rgb-brand-3), 0.7);
            transition: transform 0.3s var(--ease-out-cubic);
            transform: scaleY(0);
            transform-origin: top;
            backdrop-filter: blur(15px);
        }

        :global(body.is-nav-small) & {
            &::after {
                transform: scaleY(1);
            }
        }
    }

    .inner {
        padding: 1rem 0;
        transition: padding 0.3s var(--ease-out-cubic);


        :global(body.is-nav-small) & {
            padding: 0.5rem 0;
        }
    }

    .wrapper {
        position: relative;
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        text-align: center;

        --breakpoint-phone:    {
            flex-wrap: wrap;
        }
    }

    .logo {
        position: relative;
        z-index: 3;
        display: flex;
        flex-direction: row;
        align-items: center;

        svg {
            width: 2.4rem;

            :global(path) {
                fill: currentcolor;
            }
        }
    }

    .buttons {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        z-index: 2;

        --breakpoint-tablet:{
            gap: 1.25rem;
        };
    }

    .signup {
        --breakpoint-phone:{
            display: none;
        };
    }

    .login {
        @extend %u-text;

        --fs: var(--font-size-sm);
        position: relative;
        transform: translateY(0);
        transition: 0.3s var(--ease-out-expo);
        transition-property: transform, color;

        &::after {
            content: "";
            position: absolute;
            height: 2px;
            background: currentcolor;
            top: 115%;
            width: 100%;
            left: 0;
            pointer-events: none;
            transform: scaleX(0);
            transition: transform 0.3s var(--ease-out-expo);
            transform-origin: right;
        }

        &:hover,
        &:focus {
            &::after {
                transform: scaleX(1);
                transform-origin: left;
            }
        }

        --breakpoint-phone:{
            display: none;
        };
    }

    .toggle {
        border: none;
        background: none;
        padding: 0;
        cursor: pointer;
        align-self: normal;
        align-items: center;
        display: none;
        z-index: 2;
        color: var(--color-brand-1);
        transition: color 0.3s var(--ease-out-expo);

        :global(.has-no-bg &) {
            color: var(--color-brand-3);
        }

        :global(body.is-nav-opened &),
        :global(body.is-nav-small) & {
            color: var(--color-brand-1);
        }

        --breakpoint-phone{
            display: flex;
        };

        > span:last-child {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            height: 1.5rem;
            width: 2.25rem;

            span {
                display: flex;
                width: 100%;
                height: 4px;
                background: currentcolor;
                border-radius: 10px;
                transition: transform 0.2s var(--ease-out-cubic);
                transform: translateZ(0);

                &:nth-child(2) {
                    transition-property: opacity;
                }
            }
        }

        :global(body.is-nav-opened) & {
            color: var(--color-brand-1);

            > span {
                span {
                    &:first-child {
                        transform: translateY(calc(0.75rem - 2px)) rotate(45deg);
                    }

                    &:nth-child(2) {
                        opacity: 0;
                    }

                    &:last-child {
                        transform: translateY(calc(-0.75rem + 2px)) rotate(-45deg);
                    }
                }
            }
        }
    }
</style>

<script>



    import { addScrollObserver } from "../utils/observers";

    const heroSelectors = ["sy-hero-home"];

    class Header extends HTMLElement {
        smallThreshold = 200;
        hiddenThreshold = 100;
        toggleEl = this.querySelector(".toggle")!;
        hero = document.querySelector(heroSelectors.join(","));
        prevY = -1;

        navigation = this.querySelector(".mandatestoggle")!;


        constructor() {
            super();

            addScrollObserver(this);

            this.toggleEl.addEventListener("click", this.toggleNav);
            this.navigation.addEventListener("click", this.toggleMan);


            // addResizeObserver(this);

            this.onScroll(window.scrollY);
        }

        toggleMan() {
            document.body.classList.toggle("Man-open")
        }

        onScroll(y: number) {
            const isDown = y > this.prevY ? true : false;
            this.prevY = y;

            const classList = document.body.classList;

            const shouldBeSmall = y > this.smallThreshold;
            const isSmall = classList.contains("is-nav-small");

            if (shouldBeSmall !== isSmall) {
                classList.toggle("is-nav-small", shouldBeSmall);
            }

            const shouldBeHidden = y > this.hiddenThreshold && isDown;
            const isHidden = classList.contains("is-nav-hidden");

            if (shouldBeHidden !== isHidden) {
                classList.toggle("is-nav-hidden", shouldBeHidden);
            }
        }



        toggleNav = () => {
            document.body.classList.toggle("is-nav-opened");
        };

    }

    customElements.define("sy-head", Header);
</script>