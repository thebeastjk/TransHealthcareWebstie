---
import type { Cite } from "../types.ts"

interface Props {
    Citation: Cite,
}

const { Citation } = Astro.props;
---

<p class="inline">
    <a href={"#" + Citation.Inline} class="block">
        {"[" + Citation.Inline + "]"}
    </a>
</p>

<style>
    .inline {
        display: inline-block;
        font-size: .6rem;
        text-decoration: none;
        background-color: transparent;
        font-weight: normal;
        border: none;
        letter-spacing: .1rem;
        vertical-align: top;
    }
</style>

