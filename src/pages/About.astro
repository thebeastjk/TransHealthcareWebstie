---
import Layout from "../Layout/Layout.astro"
import AstraPic from "../assets/Astra.jpg"
import CharliPic from "../assets/Charli.jpg"
import { Image } from "astro:assets"
---


<Layout title="About">
    <div class="bg" />
    <div class="u-container">
        <div class="Column-personal">
            <div class="Profile">
                <Image src={AstraPic} class="Profile-Photo" alt="Astra Photo" fetchpriority="high"/>
                <h1 class="Name" data-sy-reveal="words">Knapp</h1>
                <p class="Profile-Bio" data-sy-reveal="lines">A student at Junipero Serra High School, in their senior year. </p>

            </div>
            <div class="Profile">
                <Image src={CharliPic} class="Profile-Photo" alt="Chali Photo" fetchpriority="high"/>
                <h1 class="Name" data-sy-reveal="words">Huang</h1>
                <p class="Profile-Bio" data-sy-reveal="lines">The bio would go here! And then Charli would write her bio here as well.
                So I wonder what happens now. (tests!!)</p>

            </div>
        </div>
    </div>
</Layout>

<style>
    .Column-personal {
        display: flex;
        flex-direction: row;
        align-items: center;
        align-content: center;
        justify-content: center;
        padding: 6rem 0 6rem;
        position: relative;
        z-index: 1;
        min-height: 100vh;
        text-align: center;
        text-overflow: ellipsis;
        word-wrap: break-word;

    }
    .Name {
        max-width: 10em;
        line-height: 1;
        font-size: 2rem;
        align-self: center;
        align-content: center;
        align-items: center;
        text-align: justify;

    }
    .Profile {
        padding-left: 50px;
        padding-right: 50px;
        align-items: center;
        flex-direction: column;
        display: flex;
    }
    .Profile-Photo {
        height: 300px;
        width: 300px;
        z-index: 10;
        border-radius: 50%;
    }
    .Profile-Bio {
        font-size: 1rem;
        font-weight: normal;
        text-align: center;
        max-width: 400px;
        //text-align-last: justify;
    }
</style>