---
import Layout from "../Layout/Layout.astro";
import HeroHome from "../Components/HeroHome.astro";
/* import TextMarquee from "../Components/TextMarquee.astro";
import GalleryText from "../Components/GalleryText.astro";
import ImageMarquee from "../components/ImageMarquee.astro";
import Faqs from "../components/Faqs.astro";
import StepsTimeline from "../components/StepsTimeline.astro";
import Plans from "../components/Plans.astro";
import Statements from "../components/Statements.astro"; */
import Introducing from "../Components/Introducing.astro";
import GL from "../Components/GL.astro";
import GLPlaces from "../Components/GlPlaces.astro";
import Button from "../Components/Button.astro";
import Tflag from "../assets/tflag.svg"
import Logo from "../assets/logo.svg";

---


<Layout title="Home">
	<div class="sy-hero-home">
		<div class="bg"/>
		<div class="u-container container">
			<div class="inner Hero">
				<div class="content">
					<div class="bold-display">
						<h1 class="u-heading title" data-sy-reveal="words">
							<span class="bold-hover">Trans healthcare</span>
						</h1>
					</div>
					<p class="u-heading subtitle" data-sy-reveal="lines">Hopefully this works now. but honest what if it doesn't? that would suck.</p>
				</div>
				<div class="bold-display">
					<span class="bold-hover" data-sy-reveal="words">HI!</span>
				</div>
			</div>
		</div>
		<div class="u-container container">
			<div class="inner">
				<div class="content">
					<h3 class="u-text">I have no idea what that thing is...</h3>
					<h2 class="u-text subtitle">Wow! What about that button over there??</h2>
				</div>
				<div class="content">
					<Button title="About!" color="primary" size="large" url="/About">About</Button>
				</div>
			</div>
		</div>
		<Introducing text="A new way to change the world." title="Uh oh..." />
	</div>

</Layout>

<style>
	.bold-display {
		font-size: 6em;
		font-weight: 800;
		display: flex;
		align-items: normal;
		letter-spacing: -.03em;
		align-content: center;

	}
	.bold-display:hover .bold-hover{
		max-width: 600px;
		font-weight: 800;
		letter-spacing: .05em;
	}
	.bold-hover {
		max-width: 200px;
		font-weight: 600;
		transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
	}
	.image-bold-hover {
		animation: Bold infinite cubic-bezier(0.4, 0, 0.2, 1);
		width: 100px;
		height: 100px;
	}
	.bold-display:hover .image-bold-hover {
		animation-play-state: running;
		animation-iteration-count: 1;
	}

	@keyframes Bold {
		0% {
			width: 100px;
			height: 100px;
		}
		50% {
			width: 600px;
			height: 600px;
		}
		100% {
			width: 100px;
			height: 100px;
		}
	}



	.sy-hero-home {
		position: relative;
		overflow: hidden;
	}
	.marquee {
		padding: 2rem 0;
		z-index: 9;
	}
	.inner {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 9rem 0 10rem;
		position: relative;
		z-index: 1;
		min-height: 100vh;


		 .Hero {
			align-items: center;
			align-content: center;
			flex-direction: column;
		}

		@media (--mq-tablet) {
			flex-direction: column;
			align-items: flex-start;
		}
	}

	.title {
		--fs: 4.5rem;
		--lh: 1;
		max-width: 5.7em;

		@media (--mq-phone) {
			--fs: 3.5rem;
		}
	}

	.subtitle {
		--fs: var(--font-size-lg);
		max-width: 25em;
		margin-top: 1.5rem;
	}
</style>