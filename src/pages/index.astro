---
import Layout from "../Layout/Layout.astro";
import Introducing from "../Components/Introducing.astro";
import Button from "../Components/Button.astro";
import InLine from "../Components/InLine.astro";
import Remembrance from "../assets/Remembrance.webp"
import Image from "astro/components/Image.astro";



const citations = [
	{
		Inline: "1",
		mla: "Johnson AH, Hill I, Beach-Ferrara J, Rogers BA, Bradford A. Common barriers to healthcare for transgender people in the U.S. Southeast. Int J Transgend Health. 2019 Dec 11;21(1):70-78. doi: 10.1080/15532739.2019.1700203. PMID: 33015660; PMCID: PMC7430435.",
	},
	{
		Inline: "2",
		mla: "Human Rights Watch. “United States: Transgender People at Risk of Violence.” Human Rights Watch, 18 Nov. 2021, www.hrw.org/news/2021/11/18/united-states-transgender-people-risk-violence",
	}
]
---


<Layout title="Home" Citations={citations}>
	<div class="sy-hero-home">

		<div class="u-container container">
			<div class="flex flex-col lg:flex-row place-content-center gap-5 py-60 Hero ">
				<div class="content">
					<div class="bold-display">
						<h1 class="u-heading title" data-sy-reveal="words">
							<span class="bold-hover">Trans healthcare</span>
						</h1>
					</div>
					<p class="u-heading subtitle" data-sy-reveal="lines">Many trans people in the American South do not have access to healthcare.
					This causes much suffering and pain within the trans community.</p>
				</div>
				<div class="secondcontent">
					<div class="bold-display" style="justify-content: right;">
						<span class="bold-hover" data-sy-reveal="words">34%</span><InLine Citation={citations[0]}/>
					</div>
					<p class="u-heading info" data-sy-reveal="lines">The percentage of trans people in the South who are uninsured.</p>
				</div>
			</div>
		</div>
		<div class="u-container">
			<div class="Call flex flex-col xl:flex-row gap-5">
				<div class="content">
					<h1 class="bold-hover">Our Main Argument:</h1>
					<h2 class="u-text">1.  If the lack of healthcare access for trans people negatively affects those people, that lack of access is wrong.</h2>
					<h2 class="u-text">2.  The lack of healthcare access for trans people negatively affects trans people.
					<h2 class="u-text">C.  Therefore that lack of access is wrong.</h2>
				</div>
				<div class="content">
					<Button title="Ethical Mandate" color="primary" size="large" url="/Ethical-Mandate">Ethical Mandate</Button>
				</div>
			</div>
		</div>
		<Introducing text="In the American South, there exists a bias and prejudice against transgender people that manifests in the form of a lack of healthcare resources for those transgender people, caused by a number of factors like harmful legislation, reduction of resource providers, and a dangerous political climate. This has lead to a significant negative impact on the mental and physical health of the transgender people affected, seen through high rates of suicide and violence toward transgender people." title="An Overview of the issue"/>
		<div class="u-container container" style="height: 60%; padding-top: 0;">
			<div class="flex flex-col-reverse lg:flex-row gap-5 py-10">
				<div class="content text-center lg:text-left w-full lg:w-3/5 align-middle place-content-center" >
					<div class="bold-display">
						<h1 class="text-2xl font-bold mb-5 tracking-wide align-middle lg:text-4xl">
							<span>Why you should care</span>
						</h1>
					</div>
					<div class="spacer"/>
					<p class="blob">People should care because of the harm that this is causing to others.
						The continuation of this hurts and kills many people each year, for no reason other than bigotry.
						This issue only gets worse with time because of how deeply ingrained in Southern society/institutions it is,
						so people need to make their feelings and beliefs on this matter known as soon as possible in order to start effective change.</p>
				</div>
				<div class="secondcontent">
					<div class="bold-display" style="justify-content: right;">
						<Image class="image" src={Remembrance} alt="Remembrance"/><InLine Citation={citations[1]}/>
					</div>
					<p class="u-heading info" data-sy-reveal="lines">A memorial of many trans people who have died.</p>
				</div>
			</div>
		</div>
	</div>

</Layout>

<style>
	.blob {
		padding-right: 2rem;
		white-space: wrap;
		text-overflow: fade;

	}
	.Call {
		align-items: center;
		justify-content: space-between;
		padding: 4rem 0 5rem;
		position: relative;
		z-index: 1;

		@media (--mq-tablet) {
			flex-direction: column;
			align-items: flex-start;
		}
	}
	.secondcontent {
		display: flex;
		flex-direction: column;
		text-align: right;
		justify-content: right;
	}
	.bold-display {
		font-size: 6em;
		font-weight: 800;
		display: flex;
		letter-spacing: -.03em;
		align-content: center;

	}
	.bold-display:hover .bold-hover{
		max-width: 600px;
		font-weight: 800;
		letter-spacing: .05em;
	}
	.bold-hover {
		font-weight: 600;
		transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
	}
	.image {
		object-fit: cover;
		height: 100%;
		width: 100%;
	}
	.bold-display:hover .image-bold-hover {
		animation-play-state: running;
		animation-iteration-count: 1;
	}

	@keyframes Bold {
		0% {
			width: 100px;
			height: 100px;
		}
		50% {
			width: 600px;
			height: 600px;
		}
		100% {
			width: 100px;
			height: 100px;
		}
	}



	.sy-hero-home {
		position: relative;
		overflow: hidden;
	}
	.marquee {
		padding: 2rem 0;
		z-index: 9;
	}
	.inner {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 9rem 0 10rem;
		position: relative;
		z-index: 1;
		min-height: 100vh;

		.Intro {
			position: relative;
			z-index: 9;
			max-width: 50rem;
			margin: 0 auto;
			padding: 1rem;
			text-align: center;
			gap: 1rem;
			display: flex;
			justify-content: center;
			align-items: center;
			flex-direction: column;
			border-radius: 1.5rem;
			backdrop-filter: blur(6px) saturate(1.05);
		}

		 .Hero {
			align-items: center;
			align-content: center;
			flex-direction: column;
		}

		@media (--mq-tablet) {
			flex-direction: column;
			align-items: flex-start;
		}
	}

	.title {
		--fs: 4.5rem;
		--lh: 1;
		max-width: 5.7em;

		@media (--mq-phone) {
			--fs: 3.5rem;
		}
	}

	.subtitle {
		--fs: var(--font-size-lg);
		max-width: 25em;
		margin-top: 1.5rem;
	}
	.info {
		font-size: var(--font-size-sm);
		margin-top: 1rem;
	}
</style>