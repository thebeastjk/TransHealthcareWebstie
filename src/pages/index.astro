---
import Layout from "../Layout/Layout.astro";
import HeroHome from "../Components/HeroHome.astro";
/* import TextMarquee from "../Components/TextMarquee.astro";
import GalleryText from "../Components/GalleryText.astro";
import ImageMarquee from "../components/ImageMarquee.astro";
import Faqs from "../components/Faqs.astro";
import StepsTimeline from "../components/StepsTimeline.astro";
import Plans from "../components/Plans.astro";
import Statements from "../components/Statements.astro"; */
import Introducing from "../Components/Introducing.astro";
import GL from "../Components/GL.astro";
import GLPlaces from "../Components/GlPlaces.astro";
import Button from "../Components/Button.astro";
import Tflag from "../assets/tflag.svg"
import Logo from "../assets/logo.svg";

---


<Layout title="Home">
	<div class="sy-hero-home">
		<div class="bg"/>
		<div class="u-container container">
			<div class="inner Hero">
				<div class="content">
					<div class="bold-display">
						<h1 class="u-heading title" data-sy-reveal="words">
							<span class="bold-hover">Trans healthcare</span>
						</h1>
					</div>
					<p class="u-heading subtitle" data-sy-reveal="lines">Many trans people in the American South do not have access to healthcare.
					This causes much suffering and pain within the trans community.</p>
				</div>
				<div class="secondcontent">
					<div class="bold-display" style="justify-content: right;">
						<span class="bold-hover" data-sy-reveal="words">34%</span>
					</div>
					<p class="u-heading info" data-sy-reveal="lines">The percentage of trans people in the South who are uninsured.</p>
				</div>
			</div>
		</div>
		<div class="u-container">
			<div class="Call">
				<div class="content">
					<h1 class="u-text subtitle">Interested to learn what you can do?</h1>
					<h2 class="u-text">Just click on the button right there!</h2>
				</div>
				<div class="content">
					<Button title="Disruptive Action!" color="primary" size="large" url="/Action">Disruptive action</Button>
				</div>
			</div>
		</div>
		<Introducing text="Hopefully we can give it to them. Thanks for helping." title="They deserve better than this." />
	</div>

</Layout>

<style>
	.Call {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 4rem 0 5rem;
		position: relative;
		z-index: 1;

		@media (--mq-tablet) {
			flex-direction: column;
			align-items: flex-start;
		}
	}
	.secondcontent {
		display: flex;
		flex-direction: column;
		text-align: right;
		justify-content: right;
	}
	.bold-display {
		font-size: 6em;
		font-weight: 800;
		display: flex;
		align-items: normal;
		letter-spacing: -.03em;
		align-content: center;

	}
	.bold-display:hover .bold-hover{
		max-width: 600px;
		font-weight: 800;
		letter-spacing: .05em;
	}
	.bold-hover {
		font-weight: 600;
		transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
	}
	.image-bold-hover {
		animation: Bold infinite cubic-bezier(0.4, 0, 0.2, 1);
		width: 100px;
		height: 100px;
	}
	.bold-display:hover .image-bold-hover {
		animation-play-state: running;
		animation-iteration-count: 1;
	}

	@keyframes Bold {
		0% {
			width: 100px;
			height: 100px;
		}
		50% {
			width: 600px;
			height: 600px;
		}
		100% {
			width: 100px;
			height: 100px;
		}
	}



	.sy-hero-home {
		position: relative;
		overflow: hidden;
	}
	.marquee {
		padding: 2rem 0;
		z-index: 9;
	}
	.inner {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 9rem 0 10rem;
		position: relative;
		z-index: 1;
		min-height: 100vh;


		 .Hero {
			align-items: center;
			align-content: center;
			flex-direction: column;
		}

		@media (--mq-tablet) {
			flex-direction: column;
			align-items: flex-start;
		}
	}

	.title {
		--fs: 4.5rem;
		--lh: 1;
		max-width: 5.7em;

		@media (--mq-phone) {
			--fs: 3.5rem;
		}
	}

	.subtitle {
		--fs: var(--font-size-lg);
		max-width: 25em;
		margin-top: 1.5rem;
	}
	.info {
		font-size: var(--font-size-sm);
		margin-top: 1rem;
	}
</style>